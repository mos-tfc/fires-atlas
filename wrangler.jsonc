// Cloudflare Worker configuration for Fires Atlas (deployed by `npx wrangler deploy` on each push to main).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "fires-atlas",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* and /admin/* run Worker code; every other path is served straight from public/.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  // Keep Text variables set in the dashboard (e.g. GEMINI_MODEL) when deploying. Secrets are always kept.
  "keep_vars": true
}
